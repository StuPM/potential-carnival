{
  "name": "BACKEND",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "tsc --noEmit false || true",
    "dev": "tsx watch dev.ts",
    "dev:typecheck": "tsc --noEmit --watch --preserveWatchOutput",
    "dev:test": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate && gql-tada generate-output"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.3.2",
    "@hono/standard-validator": "^0.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "arktype": "^2.2.0",
    "gql.tada": "^1.11.2",
    "hono": "^4.12.28",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.3",
    "@hono/node-server": "^2.0.3",
    "@types/node": "^26.1.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
