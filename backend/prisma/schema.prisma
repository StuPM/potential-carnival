generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MEDIATYPE {
  book
  film
  manga
}

model Media {
  id           String         @id
  type         MEDIATYPE
  created      DateTime       @default(now())
  film         Film?
  manga        Manga?
  mediaHistory MediaHistory[]
}

model Film {
  id               String   @id
  externalId           Int      @unique
  title            String
  originalTitle    String
  originalLanguage String
  overview         String
  posterPath       String   @unique
  releaseDate      DateTime
  watchedCount     Int      @default(1)
  genres           String[]
  media Media @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Manga {
  id               String   @id
  externalId       String   @unique
  title            String
  originalTitle    String
  originalLanguage String
  overview         String
  posterPath       String   @unique
  releaseDate      DateTime
  genres           String[]
  media            Media    @relation(fields: [id], references: [id], onDelete: Cascade)
}

model MediaHistory {
  id       String   @id @default(cuid())
  mediaId  String
  created  DateTime @default(now())
  finished DateTime
  rating   Int
  location String?
  review   String?
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}
